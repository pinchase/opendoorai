SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for local SQLite; use a PostgreSQL connection URL in production.
DATABASE_URL=
AI_ENABLED=false
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=
# OpenRouter endpoint. Keep provider credentials server-side only.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=30
AI_SITE_URL=
AI_SITE_NAME=OpenDoors AI
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=OpenDoors AI <no-reply@example.com>
ACCOUNT_RATE_LIMIT_ATTEMPTS=5
ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_TIMEOUT=259200
OPPORTUNITY_FEEDS_JSON=[]
TRUSTED_OPPORTUNITY_SOURCE_HOSTS=
MEDIA_ROOT=
FILE_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
FILE_STORAGE_OPTIONS_JSON={}
# Optional for custom domains; comma-separated HTTPS origins.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=true
